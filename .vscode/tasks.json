{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Launch Desktop GUI",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/gui.py"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Launch TensorBoard Dashboard",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/tensorboard.exe",
      "args": ["--logdir", "${workspaceFolder}/models/tensorboard_logs"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Data Preprocessing Pipeline",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/preprocess_pipeline.py", "--max_tokens", "250000"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
